# Copy to .env for local overrides, or set these as Railway service variables.
# Never commit real values here — this file is tracked.

# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Keep False in production.
DEBUG=False

# The BACKEND's own hostname(s), not the frontend's. Comma-separated.
# Railway sets RAILWAY_PUBLIC_DOMAIN itself and settings.py appends it, so this
# can be left blank on Railway.
ALLOWED_HOSTS=vaultor-production.up.railway.app

# The FRONTEND origins allowed to call this API. Full origin including scheme,
# no trailing slash, comma-separated. Leaving this blank makes settings.py fall
# back to CORS_ALLOW_ALL_ORIGINS, so it must be set before taking contributions.
# Note: Vercel preview deployments get their own URLs and are NOT covered by
# these entries — a preview build will be CORS-blocked against production.
CORS_ALLOWED_ORIGINS=https://vaultor.org,https://www.vaultor.org,https://vaultor.vercel.app
CSRF_TRUSTED_ORIGINS=https://vaultor.org,https://www.vaultor.org,https://vaultor.vercel.app

# Provided automatically by Railway's Postgres plugin.
# Leave this commented out locally to use sqlite. An empty DATABASE_URL= is NOT
# the same as unset: dj_database_url reads the empty string as a configured but
# unparseable URL and returns a dummy backend that fails every query.
# DATABASE_URL=
